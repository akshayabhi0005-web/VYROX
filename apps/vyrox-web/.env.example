# VYROX Web Application Environment Configuration
# Map Engine: OpenStreetMap (OSM) Only

# Google OAuth 2.0 Web Client ID (Google Identity Services)
# e.g., YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Facebook App ID (Facebook Login JavaScript SDK)
# e.g., YOUR_FACEBOOK_APP_ID
VITE_FACEBOOK_APP_ID=

# Backend REST API Endpoint (Production e.g., https://YOUR-RENDER-BACKEND-URL/api/v1)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Realtime Delivery Tracking WebSocket URL (Optional, e.g., wss://YOUR-RENDER-BACKEND-URL or ws://localhost:8091)
VITE_WS_BASE_URL=ws://localhost:8091
