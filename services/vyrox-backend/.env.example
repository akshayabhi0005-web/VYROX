# VYROX Backend Service Configuration — Team VELTRION
PORT=8080

# Demo Mode (true enables safe dev mock features, false enables strict production checks)
DEMO_MODE=true

# Database (PostgreSQL / Supabase in Production, or H2 in local development)
# Supabase example: jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=jdbc:h2:mem:vyroxdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=
HIBERNATE_DIALECT=

# CORS Allowed Origins (Comma-separated, e.g. https://YOUR-CLOUDFLARE-PAGES-URL,http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Security & JWT Token Generation (Use a random 256-bit+ secret in production)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google OAuth (Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (Facebook Login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMS Provider
SMS_PROVIDER_API_KEY=
DEV_MODE_OTP=123456
